# ---------- Secrets: never commit these ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials
credentials.*
.aws/

# ---------- Terraform ----------
# Local provider downloads (large, rebuilt automatically)
.terraform/
# State files describe your real infrastructure and can contain secrets
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
# Variable files often contain real values; commit only examples
*.tfvars
*.tfvars.json
!example.tfvars
# Saved plans and crash logs
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ---------- Build outputs ----------
build/
dist/
*.zip

# ---------- macOS and editors ----------
.DS_Store
.vscode/
.idea/